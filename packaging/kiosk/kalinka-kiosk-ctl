#!/usr/bin/python3
"""Starts, stops and launches the now-playing display on the server's screen.

The server's expert settings `base_config.display.*` decide whether it runs:

  kalinka-kiosk-ctl sync      (root) start, restart or stop the display to match
  kalinka-kiosk-ctl prepare   (root) resolve the launch settings for `run`;
                              exits 1 while the display is off
  kalinka-kiosk-ctl run       exec flutter-pi with them, as the service user
  kalinka-kiosk-ctl restore-display  (root) return the console and panel to their prior state
"""

import errno
import fcntl
import grp
import json
import math
import os
from pathlib import Path
import socket
import stat
import struct
import subprocess
import sys
import time

CONFIG = os.environ.get("KALINKA_CONFIG", "/etc/kalinka/kalinka_conf.cfg")
RUN_DIR = os.environ.get("RUNTIME_DIRECTORY", "/run/kalinka-kiosk")
BUNDLE = "/usr/lib/kalinka-kiosk/bundle"
UNIT = "kalinka-kiosk.service"
BACKLIGHT_DIR = Path("/sys/class/backlight")
DRM_DIR = Path("/sys/class/drm")
# Privileged hooks own this file. RUN_DIR belongs to the display service user.
VT_STATE = Path("/run/kalinka-kiosk-vt.json")
ACTIVE_TTY = Path("/sys/class/tty/tty0/active")
VC_DIR = Path("/sys/class/vc")
# Linux UAPI, <linux/kd.h> and <linux/vt.h>.
KDGKBMODE, KDSKBMODE, K_OFF = 0x4B44, 0x4B45, 4
VT_ACTIVATE, VT_WAITACTIVE, VT_DISALLOCATE = 0x5606, 0x5607, 0x5608


def _open_vt(number):
    fd = os.open(f"/dev/tty{number}", os.O_RDONLY | os.O_NOCTTY)
    return os.fdopen(fd, "rb", buffering=0)


def _keyboard_mode(tty):
    return struct.unpack("i", fcntl.ioctl(tty, KDGKBMODE, bytes(4)))[0]


def _switch_vt(tty, number):
    fcntl.ioctl(tty, VT_ACTIVATE, number)
    fcntl.ioctl(tty, VT_WAITACTIVE, number)


def _prepare_console():
    """Keep remote and USB keys on evdev without typing into a login session."""
    _restore_console()  # Retry an interrupted cleanup before saving new state.
    try:
        previous = int(ACTIVE_TTY.read_text().strip().removeprefix("tty"))
    except FileNotFoundError:
        return  # No kernel virtual console to receive key presses.
    # Leave tty1 and its getty alone, including its resets at boot or respawn.
    # /sys/class/vc/vcsN exists for allocated VTs. Pick a spare above the
    # normal login VTs (1–6), starting at Linux's MAX_NR_CONSOLES.
    kiosk = next((n for n in range(63, 6, -1) if not (VC_DIR / f"vcs{n}").exists()), None)
    if kiosk is None:
        raise OSError("No free virtual console for the kiosk")
    # Opening an unused tty allocates it. Record it first so a failed start
    # can release it even if the hook dies before changing its keyboard mode.
    saved = {"previous": previous, "kiosk": kiosk, "mode": None}
    _save_console(saved)
    with _open_vt(kiosk) as tty:
        saved["mode"] = _keyboard_mode(tty)
        _save_console(saved)
        fcntl.ioctl(tty, KDSKBMODE, K_OFF)
        _switch_vt(tty, kiosk)


def _save_console(saved):
    pending = VT_STATE.with_suffix(".tmp")
    pending.write_text(json.dumps(saved))
    pending.replace(VT_STATE)


def _restore_console():
    try:
        saved = json.loads(VT_STATE.read_text())
    except FileNotFoundError:
        return
    kiosk = saved["kiosk"]
    if saved["mode"] is not None:
        with _open_vt(kiosk) as tty:
            if ACTIVE_TTY.read_text().strip() == f"tty{kiosk}":
                _switch_vt(tty, saved["previous"])
            if _keyboard_mode(tty) == K_OFF:
                fcntl.ioctl(tty, KDSKBMODE, saved["mode"])
    with _open_vt(0) as active:
        # The kernel releases the last tty reference asynchronously. A VT
        # still held by another session can stay allocated with its mode restored.
        for attempt in range(5):
            try:
                fcntl.ioctl(active, VT_DISALLOCATE, kiosk)
                break
            except OSError as error:
                if error.errno != errno.EBUSY:
                    raise
                if attempt < 4:
                    time.sleep(0.05)
    VT_STATE.unlink()


def _display_diagonal_inches():
    """Report EDID's physical size to the app when the output is unambiguous."""
    try:
        connected = [
            status.parent for status in DRM_DIR.glob("card*-*/status")
            if status.read_text().strip() == "connected"
        ]
        if len(connected) != 1:
            return None
        edid = (connected[0] / "edid").read_bytes()[:128]
    except OSError:
        return None
    if (len(edid) != 128 or not edid.startswith(bytes.fromhex("00 ff ff ff ff ff ff 00"))
            or sum(edid) % 256 != 0):
        return None
    # When either byte is zero EDID gives an aspect ratio, not a size in cm.
    width_cm, height_cm = edid[21:23]
    if width_cm and height_cm:
        return math.hypot(width_cm, height_cm) / 2.54
    return None


def _backlight_file():
    return Path(RUN_DIR) / "backlight.json"


def _backlight_controls():
    return {p.parent.name: p for p in BACKLIGHT_DIR.glob("*/bl_power")}


def _prepare_backlight():
    """Give the display service access to one panel's power control, if any.

    Kernel guidance prefers firmware, then platform, then raw backlights.
    No DRM/DPMS subprocess: flutter-pi owns the active DRM device.
    """
    _backlight_file().unlink(missing_ok=True)
    priority = {"firmware": 0, "platform": 1, "raw": 2}

    def rank(item):
        try:
            kind = (item[1].parent / "type").read_text().strip()
        except OSError:
            kind = "raw"
        return (priority.get(kind, 3), item[0])

    for device, control in sorted(_backlight_controls().items(), key=rank):
        try:
            original = int(control.read_text().strip())
            if original not in range(5):
                continue
            os.chown(control, -1, grp.getgrnam("video").gr_gid)
            os.chmod(control, stat.S_IMODE(control.stat().st_mode) | stat.S_IWGRP)
            _backlight_file().write_text(json.dumps({"device": device, "power": original}))
            control.write_text("0")
            return
        except (OSError, ValueError, KeyError) as error:
            print(f"Backlight power unavailable: {error}", file=sys.stderr)
            _backlight_file().unlink(missing_ok=True)


def _backlight_state():
    try:
        state = json.loads(_backlight_file().read_text())
        if not isinstance(state, dict):
            return None
        # The runtime directory belongs to the app. Never trust a path from
        # its manifest in the privileged stop hook: choose from sysfs only.
        device = state.get("device")
        if not isinstance(device, str):
            return None
        control = _backlight_controls().get(device)
        power = state.get("power")
        if control is not None and type(power) is int and power in range(5):
            return control, power
    except (OSError, ValueError):
        pass
    return None


def restore_display():
    """Restore panel power and the previous console, including after a crash."""
    saved = _backlight_state()
    if saved is not None:
        control, power = saved
        try:
            control.write_text(str(power))
        except OSError as error:
            print(f"Could not restore display power: {error}", file=sys.stderr)
    _restore_console()


def _overrides():
    try:
        with open(CONFIG) as f:
            return json.load(f)
    except FileNotFoundError:
        return {}


def _interface_address(interface):
    # Mirrors the server's bind: "all" listens on loopback too, a named
    # interface only on its own address.
    if interface == "all":
        return "127.0.0.1"
    with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as sock:
        packed = struct.pack("256s", interface.encode())
        return socket.inet_ntoa(fcntl.ioctl(sock.fileno(), 0x8915, packed)[20:24])


def desired():
    """The launch settings, or None while the display is switched off."""
    o = _overrides()
    if o.get("base_config.display.enabled") is not True:
        return None
    rotation = str(o.get("base_config.display.rotation", "0"))
    host = _interface_address(o.get("base_config.server.interface", "all"))
    port = int(o.get("base_config.server.port", 8000))
    return {
        "server": f"{host}:{port}",
        "rotation": rotation if rotation in ("0", "90", "180", "270") else "0",
    }


def _launch_file():
    return os.path.join(RUN_DIR, "launch.json")


def _applied():
    try:
        with open(_launch_file()) as f:
            return json.load(f)
    except (FileNotFoundError, ValueError):
        return None


def sync():
    want = desired()
    if want is None:
        action = "stop"
    elif want != _applied():
        action = "restart"
    else:
        action = "start"
    subprocess.run(["systemctl", action, UNIT], check=True)


def prepare():
    try:
        want = desired()
        if want is not None:
            os.makedirs(RUN_DIR, exist_ok=True)
            with open(_launch_file(), "w") as f:
                json.dump(want, f)
            _prepare_backlight()
            _prepare_console()
    except (OSError, ValueError) as e:
        # Not 1, which would read as "switched off" and never be retried.
        print(e, file=sys.stderr)
        sys.exit(255)
    if want is None:
        sys.exit(1)


def run():
    with open(_launch_file()) as f:
        launch = json.load(f)
    env = dict(
        os.environ,
        KALINKA_KIOSK="true",
        KALINKA_LOCAL_DISPLAY="true",
        KALINKA_SERVER=launch["server"],
    )
    env.pop("KALINKA_DISPLAY_BACKLIGHT", None)
    backlight = _backlight_state()
    if backlight is not None:
        env["KALINKA_DISPLAY_BACKLIGHT"] = str(backlight[0])
    env.pop("KALINKA_DISPLAY_DIAGONAL_INCHES", None)
    diagonal = _display_diagonal_inches()
    if diagonal is not None:
        env["KALINKA_DISPLAY_DIAGONAL_INCHES"] = str(diagonal)
    flutter_pi = os.path.join(BUNDLE, "flutter-pi")
    args = [flutter_pi, "--release", "--rotation", launch["rotation"]]
    # Optional systemd Environment=KALINKA_KIOSK_VIDEOMODE=1920x1080@60.
    # Let flutter-pi select the preferred DRM mode when the value is empty.
    mode = env.get("KALINKA_KIOSK_VIDEOMODE", "").strip()
    if mode:
        args.extend(["--videomode", mode])
    args.append(BUNDLE)
    os.execve(flutter_pi, args, env)


if __name__ == "__main__":
    commands = {"sync": sync, "prepare": prepare, "run": run,
                "restore-display": restore_display}
    if len(sys.argv) != 2 or sys.argv[1] not in commands:
        sys.exit(f"usage: {sys.argv[0]} {'|'.join(commands)}")
    commands[sys.argv[1]]()
